+/* Fallout 2 CE Mobile: keep SDL_main and its windows on one application scene.
+ * Adapted from SDL3 b46e26e; additional scenes must never restart SDL_main. */
+#if !TARGET_OS_TV
+static UIWindowScene *UIKit_PrimaryWindowScene;
+static NSString *UIKit_PrimarySessionIdentifier;
+static BOOL UIKit_MainScheduled;
+static BOOL UIKit_MainStarted;
+static BOOL UIKit_MainRunning;
+
+BOOL UIKit_UsesSceneLifecycle(void)
+{
+    if (@available(iOS 13.0, *)) {
+        return [[NSBundle mainBundle] objectForInfoDictionaryKey:@"UIApplicationSceneManifest"] != nil;
+    }
+    return NO;
+}
+
+UIWindowScene *UIKit_GetPrimaryWindowScene(void)
+{
+    return UIKit_PrimaryWindowScene;
+}
+
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(void)
+{
+    if (@available(iOS 13.0, *)) {
+        if (UIKit_PrimaryWindowScene) {
+            return UIKit_PrimaryWindowScene.interfaceOrientation;
+        }
+    }
+    return [UIApplication sharedApplication].statusBarOrientation;
+}
+
+@interface SDLUIKitDelegate ()
+- (void)startWindowLaunch;
+@end
+
+@implementation SDLUIKitSceneDelegate
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if (![scene isKindOfClass:[UIWindowScene class]] ||
+        ![session.role isEqualToString:UIWindowSceneSessionRoleApplication]) {
+        return;
+    }
+    if (UIKit_PrimarySessionIdentifier &&
+        ![UIKit_PrimarySessionIdentifier isEqualToString:session.persistentIdentifier]) {
+        return;
+    }
+    UIKit_PrimarySessionIdentifier = [session.persistentIdentifier copy];
+    UIKit_PrimaryWindowScene = (UIWindowScene *)scene;
+
+    /* Reconnect existing windows without re-entering the game's main function. */
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    if (device) {
+        for (SDL_Window *window = device->windows; window; window = window->next) {
+            SDL_WindowData *data = (__bridge SDL_WindowData *)window->driverdata;
+            if (data.uiwindow.screen == UIKit_PrimaryWindowScene.screen) {
+                data.uiwindow.windowScene = UIKit_PrimaryWindowScene;
+            }
+        }
+    }
+    if (!UIKit_MainScheduled) {
+        UIKit_MainScheduled = YES;
+        [[SDLUIKitDelegate sharedAppDelegate] startWindowLaunch];
+    }
+}
+
+- (BOOL)handlesScene:(UIScene *)scene
+{
+    return scene == UIKit_PrimaryWindowScene && UIKit_MainRunning;
+}
+
+- (void)sceneWillResignActive:(UIScene *)scene
+{
+    if ([self handlesScene:scene]) SDL_OnApplicationWillResignActive();
+}
+
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{
+    if ([self handlesScene:scene]) SDL_OnApplicationDidEnterBackground();
+}
+
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{
+    if ([self handlesScene:scene]) SDL_OnApplicationWillEnterForeground();
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    if ([self handlesScene:scene]) SDL_OnApplicationDidBecomeActive();
+}
+
+- (void)windowScene:(UIWindowScene *)scene didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousSpace interfaceOrientation:(UIInterfaceOrientation)previousOrientation traitCollection:(UITraitCollection *)previousTraits
+{
+    if ([self handlesScene:scene]) SDL_OnApplicationDidChangeStatusBarOrientation();
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == UIKit_PrimaryWindowScene) {
+        UIKit_PrimaryWindowScene = nil;
+    }
+}
+@end
+#endif
+
